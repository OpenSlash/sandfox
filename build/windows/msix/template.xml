<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="sandfox"
        Arguments=""
        InstallLocation="C:\Program Files\Sandfox\Sandfox">
    </Installer>
    <PackageInformation
        PackageName="Sandfox"
        PackageDisplayName="Sandfox"
        PublisherName="CN=Sandfox"
        PublisherDisplayName="Sandfox"
        Version="0.1.0.0"
        PackageDescription="Wails sing-box desktop client">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="app.sandfox.desktop"
                Description="Wails sing-box desktop client"
                DisplayName="Sandfox"
                ExecutableName="sandfox"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Sandfox</DisplayName>
            <PublisherDisplayName>Sandfox</PublisherDisplayName>
            <Description>Wails sing-box desktop client</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="sandfox.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
